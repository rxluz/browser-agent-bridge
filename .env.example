# Copy these values into your shell before starting server/bridge.js.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRIDGE_TOKEN=replace-with-a-random-32-character-minimum-token
# Leave unset unless you intentionally need the eval tool.
# BRIDGE_ENABLE_EVAL=1
